# Copie para .env para rodar localmente (cargo run -- --dry-run --verbose).
# No GitHub Actions estes valores vêm dos secrets do repositório.
# Variável vazia = checagem fica "ignorado".

# Alvos privados
ENGINE_URL=
ARNUT_URL=
N8N_URL=
EASYPANEL_URL=
QDRANT_URL=

# Postgres (mesmas variáveis da Nutra-API2)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true
# PEM da CA em base64 (opcional; sem ela o certificado não é validado)
DB_SSL_CA=

# Firebase: JSON completo da service account em uma linha
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare (checagem da conta; o status global é público)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# E-mail de alerta (SMTP Hostinger, mesmas variáveis da Nutra-API2)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Nutra Status
EMAIL_USE_SSL=true
# Destinatários separados por vírgula (padrão: eziochifunga.dev@gmail.com)
ALERT_EMAIL_TO=eziochifunga.dev@gmail.com

# Issues no GitHub (no Actions já vêm prontos)
GITHUB_TOKEN=
GITHUB_REPOSITORY=nutra-nutraentes/Nutra-Status
# Usuário do GitHub mencionado nas issues (gera push no app do GitHub)
ALERT_GITHUB_USER=
# Opcional: padrão https://<dono>.github.io/<repo>/
STATUS_PAGE_URL=
